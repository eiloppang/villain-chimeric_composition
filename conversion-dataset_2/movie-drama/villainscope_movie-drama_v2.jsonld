  {
    "@id": "http://villainscope.org/villain/villain_movie_0140",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Bureaucratic Arrogance: Masking professional incompetence with an elitist and condescending attitude toward colleagues and subordinates. | Vengeful Pettiness: Prioritizing personal grudges and professional jealousy over the integrity of judicial investigations and the pursuit of truth. | Moral Bankruptcy: Abandoning justice and shielding violent criminals to secure institutional power and political favors. | Political Opportunism: Exploiting state-sponsored violence and political turmoil to eliminate rivals and solidify personal authority. | Elite Pretentiousness: Maintaining a facade of intellectual superiority to evade accountability for moral failures and professional negligence."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
