villain:villain_001 a schema1:Person,
        villain:Character,
        villain:Villain,
        foaf:Person ;
    rdfs:label "lago" ;
    schema1:age 28 ;
    schema1:description "Cleverness: Manipulative, highly intellectual, quick-witted. | Narcissism: Considers oneself smarter than others, excessive pride and self-esteem. | Motiveless malignity: Executes evil deeds perfectly without apparent reason. | Tragedian in real life - William Hazlitt: Practicing tragedy in reality with originality. | Lack of morality: Indifferent to moral good and evil, sees everything crookedly, views all humans equally. | Speech patterns: Hesitant speech, starts and stops, echoes the end of others' sentences, skillfully combines similar vocabulary to induce outbursts of accumulated emotions. | Dual nature: Ruthless, selfish, yet empathetic, popular among friends, instills trust in others. | Insights: Penetrates thoughts, feelings, desires emerging from human inner self, exploits doubts, hatred, and solidifies the urge to kill." ;
    schema1:gender "Male" ;
    schema1:image <https://commons.wikimedia.org/wiki/Special:FilePath/Edwin_Booth_as_Iago_crop.jpg> ;
    schema1:isPartOf work:work_001 ;
    schema1:jobTitle "advisor" ;
    schema1:name "lago" ;
    schema1:sameAs wd:Q1655364 ;
    villain:appearsIn work:work_001 ;
    villain:ethnicity "Venetian" ;
    villain:facialFeatures "Pale; White; Mustache" ;
    villain:hairDescription "Brown, Black hair" ;
    villain:hasPersonalityTrait trait:Cleverness,
        trait:Cynicism,
        trait:Dual_nature,
        trait:Insights,
        trait:Lack_of_morality,
        trait:Machinations,
        trait:Motiveless_malignity,
        trait:Narcissism,
        trait:Racism,
        trait:Sexism,
        trait:Speech_patterns,
        trait:Tragedian_in_real_life_-_William_Hazlitt ;
    villain:occupation "advisor" ;
    villain:personalityDetails "Cleverness: Manipulative, highly intellectual, quick-witted. | Narcissism: Considers oneself smarter than others, excessive pride and self-esteem. | Motiveless malignity: Executes evil deeds perfectly without apparent reason. | Tragedian in real life - William Hazlitt: Practicing tragedy in reality with originality. | Lack of morality: Indifferent to moral good and evil, sees everything crookedly, views all humans equally. | Speech patterns: Hesitant speech, starts and stops, echoes the end of others' sentences, skillfully combines similar vocabulary to induce outbursts of accumulated emotions. | Dual nature: Ruthless, selfish, yet empathetic, popular among friends, instills trust in others. | Insights: Penetrates thoughts, feelings, desires emerging from human inner self, exploits doubts, hatred, and solidifies the urge to kill." ;
    villain:personalityTrait "Cleverness",
        "Cynicism",
        "Dual nature",
        "Insights",
        "Lack of morality",
        "Machinations",
        "Motiveless malignity",
        "Narcissism",
        "Racism",
        "Sexism",
        "Speech patterns",
        "Tragedian in real life - William Hazlitt" ;
    villain:personalityTraits "Cleverness; Narcissism; Motiveless malignity; Tragedian in real life - William Hazlitt; Lack of morality; Speech patterns; Dual nature; Insights; Machinations; Sexism; Racism; Cynicism" ;
    villain:wikidataDescription "fictional character in William Shakespeare's Othello"@en ;
    villain:wikidataEntity wd:Q1655364 ;
    villain:wikidataLabel "Iago"@en ;
    owl:sameAs wd:Q1655364 ;
    wdt:P31 wd:Q15632617,
        wd:Q3375722 ;
