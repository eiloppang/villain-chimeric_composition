  {
    "@id": "http://villainscope.org/villain/villain_movie_0019",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Tragic backstory: Formerly kind-hearted, turned evil after not being invited to Aurora's christening. (Warns Aurora that she will die on her 16th birthday) | Wickedness: Commits murder for personal gain. | Narcissism: Views others as beneath them (treats them like pets). | Likes certain animals: Fond of their pet raven (Diablo)."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Female"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://commons.wikimedia.org/wiki/Special:FilePath/Maleficent_-_Sleeping_Beauty_1970_Reissue_Trailer.png"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_movie_0019"
      }
    ],
