      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Explosive Volatility: Possessing a hair-trigger temper that transitions from calm conversation to lethal violence within seconds over minor provocations. | Eccentric Professionalism: Maintaining a flamboyant and stylish public persona while operating a highly efficient and ruthless criminal enterprise. | Hypersensitive Pride: Viewing perceived slights or lack of respect as existential threats that demand immediate and disproportionate retaliation. | Ruthless Pragmatism: Eliminating threats or obstacles with chilling efficiency, prioritizing the reputation and survival of the criminal domain above all."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
