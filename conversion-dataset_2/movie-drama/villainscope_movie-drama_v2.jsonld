  {
    "@id": "http://villainscope.org/villain/villain_movie_0174",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/age": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 60
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Deception: Utilizing a high-pitched, sing-song voice and the promise of free sweets (lollipops, treacle tart) to exploit children’s innocence and desires. | Sadistic: Deriving overt pleasure from the terror of his victims, viewing the capture of children not just as a job for the Baroness, but as a deeply gratifying personal sport. | Obsession: Possessing a pathological focus on the \"scent\" of children, which he uses to dehumanize them into mere prey to be scented and bagged. | Loyalty: Operating as the official enforcement arm of the Vulgarian regime's anti-child laws, showing total compliance with authority while exercising his own brand of cruelty."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
