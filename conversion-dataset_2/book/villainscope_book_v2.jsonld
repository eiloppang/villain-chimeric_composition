    "http://schema.org/age": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 40
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Cannibalism: Kills and cooks people they dislike, giving them a sense of nesting inside their mother's womb. It's an act of seclusion from the outside world, providing comfort and a sense of internal abundance that revives them. | Cleverness: A genius serial killer, adept at various professions and fluent in multiple languages, earning the title of genius in various fields. | PTSD (Posttraumatic Stress Disorder): PTSD from past trauma. | Psychopath: Lacks empathy and feels no remorse after committing murder. | Emphasizes manners. "
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_008"
      }
    ],
    "http://schema.org/jobTitle": [
      {
        "@value": "Psychiatrist; Gourmet; Artist, Scholar; Surgeon; Forensic Scientist"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "The Master of Poisoncraft"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Hannibal Lecter"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.wikidata.org/entity/Q211013"
      }
    ],
    "http://villainscope.org/villain/abilities": [
      {
        "@value": "The Master of Poisoncraft"
      }
    ],
    "http://villainscope.org/villain/appearsIn": [
      {
        "@id": "http://villainscope.org/work/work_008"
      }
    ],
    "http://villainscope.org/villain/ethnicity": [
      {
        "@value": "Lithuanian noble descent"
      }
    ],
    "http://villainscope.org/villain/hasAbility": [
      {
        "@id": "http://villainscope.org/ability/The_Master_of_Poisoncraft"
      }
    ],
    "http://villainscope.org/villain/hasPersonalityTrait": [
      {
        "@id": "http://villainscope.org/trait/Cannibalism"
      },
      {
        "@id": "http://villainscope.org/trait/Cleverness"
      },
      {
        "@id": "http://villainscope.org/trait/PTSD_Posttraumatic_Stress_Disorder"
      },
      {
        "@id": "http://villainscope.org/trait/Psychopath"
      },
      {
