      {
        "@value": "Criminal mastermind"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Noah Cross"
      }
    ],
    "http://villainscope.org/villain/appearsIn": [
      {
        "@id": "http://villainscope.org/work/work_movie_0127"
      }
    ],
