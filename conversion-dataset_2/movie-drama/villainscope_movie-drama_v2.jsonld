      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Cruelty: Engaging in cold-blooded violence and legal manipulation to secure familial wealth and maintain class-based dominance. | Authoritative Dominance: Exercising absolute control over subordinates, notably the assassin J.G. Jopling, to execute a systematic elimination of any perceived obstacles | Emotional Callousness: Demonstrating zero remorse for matricide or the suffering of others while focusing exclusively on personal gain and status. | Persistence: Maintaining a relentless pursuit of targets through both formal legal channels and illicit violence without regard for moral consequences."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
