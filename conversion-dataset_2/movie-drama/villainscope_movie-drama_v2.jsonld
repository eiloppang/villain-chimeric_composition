        "@value": 56
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Ruthlessness: Will do anything to obtain money | regardless of means and methods | Traumatized Madness: Numbing haunting memories of past trauma through substance abuse and manifesting internal pain as external violence. | Sadistic Ritualism: Transforming murder into a psychological torture and choreographed ritual by using a musical pocket watch as a countdown. | Amoral Ruthlessness: Betraying allies and sacrificing human lives without hesitation to ensure personal survival or achieve vengeance. | Tactical Brilliance: Planning complex heists with meticulous precision while maintaining absolute command over a volatile gang of outlaws. | Cold Cynicism: Viewing human loyalty and life as disposable commodities, driven by a profound lack of empathy."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_movie_0113"
      }
    ],
