    "http://schema.org/description": [
      {
        "@value": "Personality changes: Before becoming Darth Vader, Considerate and kind to friends. | Loneliness and feelings of failure due to the deaths of his wife and mother lead to a change in personality: Deeply affectionate towards those he loves. | Cruelty: Torture. Immediate execution for disobeying his orders or failing to carry them out."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
