  {
    "@id": "http://villainscope.org/villain/villain_movie_0159",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Corruption: Moral Compromise — Sacrificing personal integrity and long-standing values to maintain political power within a corrupt party machine. | Cynical Pragmatism: Rationalized Betrayal — Dismissing the betrayal of public trust as a necessary evil for survival in a \"realistic\" political landscape. | Reputational Fixation: Prioritizing the maintenance of a heroic public image while concealing clandestine involvement in illicit corporate interests. | Moral Collapse: Experiencing a catastrophic internal fracture when the conflict between past idealism and present corruption becomes irreconcilable."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
