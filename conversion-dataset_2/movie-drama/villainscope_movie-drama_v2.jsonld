    "http://schema.org/description": [
      {
        "@value": "Deception: He utilizes a \"quiet earnestness\" and a \"boy-next-door\" image to disarm his legal counsel and the jury, making his claims of innocence feel deeply sincere. | Strategic: He maintains a dark, symbiotic loyalty with his wife, Romaine (Christine), conspiring to commit murder and execute a complex double-deception to secure an acquittal."
      }
    ],
