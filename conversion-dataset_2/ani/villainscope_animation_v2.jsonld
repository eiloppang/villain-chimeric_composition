  {
    "@id": "http://villainscope.org/villain/villain_ani_003",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/age": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 20
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Unfortunate childhood: Strained relationship with father (desires to become a hero influenced by a heroic grandmother, but strained relationship due to father's opposition). | Habit: Scratches face when irritated or stressed. | Stubbornness: Resists having his soul consumed by the boss. | Obsession: Obsessed with murder. | Madness | Mistreatment: Lacks morality, feels joy rather than remorse after killing household members. | Criminal: Mass murder | Name - Antagonist's appellation: '死柄木弔 (Shibarakimotsurugi)' - Incorporating two characters related to death. | Birthday: April 4th. Symbolizes death."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_ani_002"
      }
    ],
    "http://schema.org/jobTitle": [
      {
        "@value": "Leader of the Surrealist Liberation Front"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "Collapse; Initially; Anything touched perfectly with five fingers collapses; The range of the effect has widened; collapses even if touched with just one finger or foot, not necessarily the whole hand or foot."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Tomura Shigaraki"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.wikidata.org/entity/Q133538012"
      }
    ],
    "http://villainscope.org/villain/abilities": [
      {
        "@value": "Collapse; Initially; Anything touched perfectly with five fingers collapses; The range of the effect has widened; collapses even if touched with just one finger or foot, not necessarily the whole hand or foot."
      }
    ],
