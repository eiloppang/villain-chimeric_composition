  {
    "@id": "http://villainscope.org/villain/villain_movie_0018",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Obsession: Obsessed with the seven deadly sins of humanity. He meticulously plans and executes murders targeting individuals whom he perceives to embody these sins. For instance, he might force-feed excessive amounts of food to someone who indulges in gluttony until they die. | Cleverness: Highly intelligent, capable of outmaneuvering law enforcement. | Cunning: Deceptive and crafty. | Passionate: Shows immense passion in committing his murders, viewing them as a form of divine retribution against those who commit sins."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
