        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 72
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Mistreatment: Derives pleasure from controlling others, with amplified joy. Otherwise, experiences no joy. | Loves only death and destruction: Exists solely for the desire of revenge against those who thwart it. | Lack of morality: Lacks the ability to distinguish between good and evil."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
