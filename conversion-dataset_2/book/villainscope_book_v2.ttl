    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Edwin_Booth_as_Iago_crop.jpg> ;
    foaf:gender "Male" ;
    foaf:name "lago" ;
    foaf:title "advisor" .

villain:villain_002 a schema1:Person,
        villain:Character,
        villain:Villain,
        foaf:Person ;
    rdfs:label "Richard III" ;
    schema1:age 32 ;
    schema1:description "Extravagance: Excessive spending and wastefulness. | Difficult temper: Quick to anger, prone to outbursts. | Ignorance: Lacks awareness of the limits of their power, believes themselves invincible, disregards advice, becomes enraged at rightful criticism. | Irresponsible: Acts without regard for consequences or duties. | Self-indulgent: Overly lenient towards oneself, indulges in personal desires." ;
    schema1:gender "Male" ;
    schema1:image <https://commons.wikimedia.org/wiki/Special:FilePath/William_Hogarth_-_David_Garrick_as_Richard_III_-_Google_Art_Project.jpg> ;
    schema1:isPartOf work:work_002 ;
    schema1:jobTitle "King" ;
    schema1:name "Richard III" ;
    schema1:sameAs wd:Q652011 ;
    villain:appearsIn work:work_002 ;
    villain:distinctiveFeatures "Hunch; Limp; Withered arm" ;
    villain:ethnicity "Yorkists" ;
    villain:facialFeatures "White; Blue eyes;" ;
    villain:hairDescription "fair-haired hair" ;
    villain:hasPersonalityTrait trait:Commits_wrongdoing_without_dirtying_their_own_hands,
        trait:Difficult_temper,
        trait:Extravagance,
        trait:Ignorance,
        trait:Irresponsible,
