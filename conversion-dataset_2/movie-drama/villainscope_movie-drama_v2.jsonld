  {
    "@id": "http://villainscope.org/villain/villain_movie_0132",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "God Complex: Absolute Dominion — Exercising total control over vital natural resources and human lives, driven by the belief that immense power grants immunity from morality and law. | Predatory Narcissism: Transgressive Ownership — Violating the most sacred human boundaries, including incest and betrayal, to satisfy a pathological need for total domination over one's legacy. | Nihilistic Visionary: Amoral Pragmatism — Dismissing horrific crimes as mere steps toward \"the future\" and viewing human suffering with chilling indifference for the sake of long-term control. | Deceptive Civility: Aristocratic Facade — Maintaining a mask of a respectable, elderly statesman to conceal a monstrous interior that stops at nothing to expand its domain. | Absolute Hubris: Societal Untouchability — Assuming an eternal right to dictate the survival of entire communities while feeling fundamentally immune to any legal or social consequences."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_movie_0127"
      }
    ],
