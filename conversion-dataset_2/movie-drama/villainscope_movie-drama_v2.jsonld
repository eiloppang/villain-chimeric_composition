  {
    "@id": "http://villainscope.org/villain/villain_movie_0160",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Mechanical Hunting: Exhibiting an anomalous and focused determination to pursue specific targets, showing a mechanical-like indifference to pain or injury during the hunt. | Anomalous Intelligence: Demonstrating a level of strategic planning and environmental manipulation that suggests a dark, near-supernatural intelligence behind its predatory actions."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
