      {
        "@value": "Knight; General; Emperor of the Galactic Empire"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "Possesses immense strength; Capable of using the Force, especially adept at using it to block opponents' prayers."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Darth Vader"
      }
    ],
