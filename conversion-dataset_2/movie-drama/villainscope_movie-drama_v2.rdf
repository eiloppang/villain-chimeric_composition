    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/God_Complex"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Manipulative_Rationalization"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Artistic_Detachment"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Paternalistic_Authority"/>
