villain:villain_movie_0174 a schema1:Person,
        villain:Character,
        villain:Villain,
        foaf:Person ;
    rdfs:label "Child Catcher" ;
    schema1:age 60 ;
    schema1:description "Deception: Utilizing a high-pitched, sing-song voice and the promise of free sweets (lollipops, treacle tart) to exploit children’s innocence and desires. | Sadistic: Deriving overt pleasure from the terror of his victims, viewing the capture of children not just as a job for the Baroness, but as a deeply gratifying personal sport. | Obsession: Possessing a pathological focus on the \"scent\" of children, which he uses to dehumanize them into mere prey to be scented and bagged. | Loyalty: Operating as the official enforcement arm of the Vulgarian regime's anti-child laws, showing total compliance with authority while exercising his own brand of cruelty." ;
    schema1:gender "Male" ;
    schema1:isPartOf work:work_movie_0166 ;
