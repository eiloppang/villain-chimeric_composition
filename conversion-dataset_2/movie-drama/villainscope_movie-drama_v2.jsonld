      }
    ],
    "http://villainscope.org/villain/hasPersonalityTrait": [
      {
        "@id": "http://villainscope.org/trait/High_intelligence"
      },
      {
        "@id": "http://villainscope.org/trait/Deceitfulness"
      },
      {
        "@id": "http://villainscope.org/trait/Incestuous"
      },
