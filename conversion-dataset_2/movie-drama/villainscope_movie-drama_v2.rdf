    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Explosive_Volatility"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Eccentric_Professionalism"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Hypersensitive_Pride"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Ruthless_Pragmatism"/>
    <villain:hasPersonalityTrait rdf:resource="http://villainscope.org/trait/Charismatic"/>
    <villain:personalityTrait>Explosive Volatility</villain:personalityTrait>
    <villain:personalityTrait>Eccentric Professionalism</villain:personalityTrait>
    <villain:personalityTrait>Hypersensitive Pride</villain:personalityTrait>
    <villain:personalityTrait>Ruthless Pragmatism</villain:personalityTrait>
    <villain:personalityTrait>Charismatic</villain:personalityTrait>
    <villain:personalityDetails>Explosive Volatility: Possessing a hair-trigger temper that transitions from calm conversation to lethal violence within seconds over minor provocations. | Eccentric Professionalism: Maintaining a flamboyant and stylish public persona while operating a highly efficient and ruthless criminal enterprise. | Hypersensitive Pride: Viewing perceived slights or lack of respect as existential threats that demand immediate and disproportionate retaliation. | Ruthless Pragmatism: Eliminating threats or obstacles with chilling efficiency, prioritizing the reputation and survival of the criminal domain above all.</villain:personalityDetails>
    <schema1:description>Explosive Volatility: Possessing a hair-trigger temper that transitions from calm conversation to lethal violence within seconds over minor provocations. | Eccentric Professionalism: Maintaining a flamboyant and stylish public persona while operating a highly efficient and ruthless criminal enterprise. | Hypersensitive Pride: Viewing perceived slights or lack of respect as existential threats that demand immediate and disproportionate retaliation. | Ruthless Pragmatism: Eliminating threats or obstacles with chilling efficiency, prioritizing the reputation and survival of the criminal domain above all.</schema1:description>
    <villain:occupation>Drug dealer; Crime lord</villain:occupation>
    <schema1:jobTitle>Drug dealer; Crime lord</schema1:jobTitle>
    <foaf:title>Drug dealer; Crime lord</foaf:title>
  </rdf:Description>
