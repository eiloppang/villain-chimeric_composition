      }
    ],
    "http://schema.org/jobTitle": [
      {
        "@value": "Dark Wizard"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "Teleportation; Unassisted Flight; Legilimency & Occlumency: Psychological Infiltration;  Parseltongue: Interspecies Communication — Holding the hereditary ability to communicate with and command serpents, a trait historically associated with the darkest and most powerful bloodlines."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Voldemort"
      }
    ],
    "http://schema.org/sameAs": [
