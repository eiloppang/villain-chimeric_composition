    "http://villainscope.org/villain/occupation": [
      {
        "@value": "Police captain"
      }
    ],
    "http://villainscope.org/villain/personalityDetails": [
      {
        "@value": "External Mask: Fatherly Mentorship — Presenting as a wise, paternal authority figure to groom subordinates and mask cold-blooded corruption. | Machiavellian Ruthlessness: Employing extreme violence and systemic corruption to maintain absolute control over both the criminal underworld and the police force. | Manipulation: Exploiting the ambitions and weaknesses of subordinates to transform them into compliant tools for personal gain. | Hypocritical Justice: Upholding a facade of strict law enforcement while orchestrating large-scale criminal activities behind the scenes. | Charismatic Authority: Commanding unwavering respect through a formidable presence and sophisticated rhetoric to conceal a predatory nature."
      }
    ],
