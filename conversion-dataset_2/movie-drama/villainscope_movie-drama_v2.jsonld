  {
    "@id": "http://villainscope.org/villain/villain_movie_0130",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Strategic Opportunism: Executing patient and calculated maneuvers to isolate targets and ensure the continued propagation of the species across the biosphere. | Existential Paranoia: Inducing total distrust and psychological collapse among host groups by exploiting the inability to distinguish friend from foe. | Egoism: Driven by a singular, relentless focus on self-preservation and expansion, viewing all other life forms merely as raw material for assimilation."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Mutated"
      }
    ],
    "http://schema.org/isPartOf": [
