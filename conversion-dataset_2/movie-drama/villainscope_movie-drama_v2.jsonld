    "http://villainscope.org/villain/occupation": [
      {
        "@value": "Drug lord; Con artist; Drug trafficker"
      }
    ],
    "http://villainscope.org/villain/personalityDetails": [
      {
        "@value": "Physical Disorder: Limping | Smoking: Smokes cigarettes after committing a robbery. | Deceptive Frailty: The \"Verbal\" Persona — Presenting as Roger \"Verbal\" Kint, a physically weak and disabled con artist with cerebral palsy to divert suspicion and evoke pity. | Cleverness: Orchestrating multi-layered criminal operations with chilling precision, viewing people merely as disposable pawns in a larger, invisible game of power."
      }
    ],
