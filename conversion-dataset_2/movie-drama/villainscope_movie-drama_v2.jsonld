      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1000
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Tyrant: Extremely cruel and lacks empathy. | Cleverness: Devises strategies effectively. | Charisma: Capable of leading armies. | Obsession: Power (cursed Narnia to maintain power and keep it in perpetual winter). | Narcissism: Self-centeredness. | Disorder: Delusional - Believes that only they can rule Narnia and must do so."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Female"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_movie_0011"
      }
    ],
    "http://schema.org/jobTitle": [
      {
        "@value": "Queen"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "Dark magic: Curses, illusions, seasonal manipulation; Frigiokinesis: can create, shape and manipulate cold; Superhuman feature: speed, reflexes; Swordsmanship"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Jadis(The White Witch)"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.wikidata.org/entity/Q1997439"
      }
