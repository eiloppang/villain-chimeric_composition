  {
    "@id": "http://villainscope.org/villain/villain_movie_0028",
    "@type": [
      "http://villainscope.org/villain/Villain",
      "http://villainscope.org/villain/Character",
      "http://schema.org/Person",
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://schema.org/description": [
      {
        "@value": "Wickedness: Steals the voice of the Little Mermaid, Ariel. | Cunning | Cheerful: Has a sense of humor. | Vanity: Tries to overcome complexes by boasting about one's appearance. | Articulate: Speaks well."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Female"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_movie_0029"
      }
    ],
    "http://schema.org/jobTitle": [
      {
        "@value": "Sea witch"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "Soul Binding: The power to create unbreakable, magically enforced contracts that can transform or imprison the souls of those who fail to meet the terms; Shapeshifting; Size Manipulation; Telepathic:  Maintaining absolute control over her moray eel spies, Flotsam and Jetsam, through a high level of sensory and telepathic connection."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Ursula"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "http://www.wikidata.org/entity/Q6175066"
      }
    ],
    "http://villainscope.org/villain/abilities": [
      {
        "@value": "Soul Binding: The power to create unbreakable, magically enforced contracts that can transform or imprison the souls of those who fail to meet the terms; Shapeshifting; Size Manipulation; Telepathic:  Maintaining absolute control over her moray eel spies, Flotsam and Jetsam, through a high level of sensory and telepathic connection."
      }
