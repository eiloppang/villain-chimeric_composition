    "http://schema.org/age": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 5
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Predestined Malevolence: Theological Determinism — Operating under a preordained destiny as the Antichrist, where evil is not a choice but an inherent biological and spiritual essence | Son of a demon: Megalomanical Entitlement. Satanic Sovereignty. Believing in his absolute right to rule the Earth as the rightful heir to his father (Satan), driven by a grand sense of divine, albeit dark, purpose. | Nihilism: Misanthropic Detachment — Viewing humanity as a weak, failing species that requires purging, exhibiting a total lack of empathy and a cold indifference toward human suffering"
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
    "http://schema.org/isPartOf": [
      {
        "@id": "http://villainscope.org/work/work_movie_0052"
      }
    ],
    "http://schema.org/knowsAbout": [
      {
        "@value": "Impeccable immunity: Never falls ill; Causes malfunctions in machinery; Induces hallucinations; Can twist human hearts; Can control animals like dogs, horses, etc."
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Damien Thorn"
      }
    ],
