    ],
    "http://schema.org/age": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 40
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Obsession: Driven by a pathological need to surpass Alfred Borden, leading him to sacrifice his morality, wealth, and ultimately his very existence to achieve the ultimate illusion. |  | Narcissism: The Hunger for Applause — Prioritizing the audience's adoration and the \"look on their faces\" over the craft itself, reflecting a personality that seeks validation through external spectacle. | Persistence: The Widow’s Grief Twisted — Initially motivated by the tragic loss of his wife, his grief eventually mutates into a bitter, lifelong vendetta that blinds him to the human cost of his actions."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
    ],
