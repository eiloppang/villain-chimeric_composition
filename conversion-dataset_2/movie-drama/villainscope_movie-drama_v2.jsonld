    "http://schema.org/description": [
      {
        "@value": "Hedonistic Excess: Engaging in extreme substance abuse and unrestrained luxury to satisfy immediate physical and psychological cravings. | Charismatic Manipulation: Utilizing powerful oratory and magnetic charm to incite fraudulent behavior and absolute loyalty in subordinates. | Unchecked Avarice: Pursuing immense wealth and material dominance with a total disregard for ethical boundaries or legal consequences. | Grandiose Narcissism: Maintaining an inflated sense of self-importance and viewing others as mere tools for personal glorification. | Amoral Opportunism: Exploiting systemic vulnerabilities and human greed to maximize personal gain while dismissing social responsibility."
      }
    ],
    "http://schema.org/gender": [
      {
        "@value": "Male"
      }
